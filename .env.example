# Environment example for per-team deployments
# Copy to .env and edit values before running `docker compose -f docker-compose.team.yml up -d --build`

# App
# Required: random value, 32+ chars (e.g. `openssl rand -hex 32`)
SECRET_KEY=
TARGETHUB_PUBLIC_URL=http://localhost:8000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://targethub:changeme@postgres:5432/targethub

# Redis (broker + cache)
REDIS_URL=redis://redis:6379/0

# MinIO (optional)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional serial provider configuration.
# The provider key is normalized into the environment variable prefix.
# Example capability provider_key: serial.dev.01
#TARGETHUB_SERIAL_DEV_01_PORT=/dev/ttyUSB0
#TARGETHUB_SERIAL_DEV_01_BAUDRATE=115200
#TARGETHUB_SERIAL_DEV_01_TIMEOUT=0.2
