# TargetHub environment. `scripts/install.sh` generates a ready-to-use .env with random
# secrets; copy this file by hand only if you prefer to manage values yourself.
# Keep .env private (chmod 600) and out of version control.

# --- Stack identity (run several stacks on one host by changing these) ---
COMPOSE_PROJECT_NAME=targethub
# Host address/port the API is published on. 127.0.0.1 = this host only (use with TLS proxy);
# set TARGETHUB_BIND=0.0.0.0 to serve the LAN directly.
TARGETHUB_BIND=127.0.0.1
TARGETHUB_PORT=8000
# Uncomment to add the Caddy TLS overlay (also set TARGETHUB_DOMAIN, see docs/deployment/tls.md)
#COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
#TARGETHUB_DOMAIN=hub.example.com

# --- Required secrets ---
# Signs login tokens. Random, 32+ chars: `openssl rand -hex 32`
SECRET_KEY=
# Database password (URL-safe characters only): `openssl rand -hex 24`
POSTGRES_PASSWORD=
# One-time token that authorises creating the first admin in the UI or via
# POST /api/v1/auth/bootstrap. Useless once any user exists. `openssl rand -hex 16`
ADMIN_BOOTSTRAP_TOKEN=
# Bearer token for Prometheus scraping /metrics (admins may also use their login token).
# Leave empty to restrict /metrics to admins. `openssl rand -hex 16`
METRICS_TOKEN=

# --- App ---
# Public URL users type; must match what browsers and agents use to reach the hub.
TARGETHUB_PUBLIC_URL=http://localhost:8000
LOG_LEVEL=INFO
API_WORKERS=2
TARGETHUB_VERSION=0.1.0

# Failed logins / password changes / bootstrap attempts allowed per IP within the window.
#AUTH_MAX_FAILURES=5
#AUTH_FAILURE_WINDOW_SECONDS=300

# Optional serial provider configuration for sim/local providers.
# Example capability provider_key: serial.dev.01
#TARGETHUB_SERIAL_DEV_01_PORT=/dev/ttyUSB0
#TARGETHUB_SERIAL_DEV_01_BAUDRATE=115200
#TARGETHUB_SERIAL_DEV_01_TIMEOUT=0.2
