# TargetHub server environment. `scripts/install.sh` (Linux/macOS) or `scripts/install.ps1`
# (Windows) generates a ready-to-use .env with random secrets; copy this file by hand only if
# you prefer to manage values yourself. Keep .env private and out of version control.

# --- Stack identity (run several stacks on one host by changing these) ---
COMPOSE_PROJECT_NAME=targethub
# Host address/port the API is published on. 127.0.0.1 = this host only (use with TLS proxy);
# 0.0.0.0 serves the LAN directly.
TARGETHUB_BIND=127.0.0.1
TARGETHUB_PORT=8000
# Uncomment to add the Caddy TLS overlay (also set TARGETHUB_DOMAIN, see docs/deployment/tls.md)
#COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
#TARGETHUB_DOMAIN=hub.example.com
# Use a published image instead of building locally (see docs/deployment/install.md)
#TARGETHUB_IMAGE=ghcr.io/omkar-motaghare/targethub:0.2.0

# --- Required secrets ---
# Signs login tokens and hashes Agent credentials. Random, 32+ chars: `openssl rand -hex 32`
SECRET_KEY=
# Database password (URL-safe characters only): `openssl rand -hex 24`
POSTGRES_PASSWORD=
# One-time token that authorises creating the first admin in the UI or via
# POST /api/v1/auth/bootstrap. Useless once any user exists. `openssl rand -hex 16`
ADMIN_BOOTSTRAP_TOKEN=
# Bearer token for Prometheus scraping /metrics (admins may also use their login token).
METRICS_TOKEN=

# --- App ---
# Public URL users type; must match what browsers and Agents use to reach the server.
TARGETHUB_PUBLIC_URL=http://localhost:8000
LOG_LEVEL=INFO
# text or json (structured logs for log shippers)
#TARGETHUB_LOG_FORMAT=json
API_WORKERS=2
TARGETHUB_VERSION=0.2.0

# --- Power systems ---
# API key for the DD Endpoint Control API. A DD power capability references it by name
# (provider_config.api_key_env). Add more variables if you run several DD servers.
#TARGETHUB_DD_API_KEY=

# --- Behaviour ---
# Simulated providers (fake power/serial for demos). Off in production unless enabled here.
#ALLOW_SIMULATED_PROVIDERS=false
# Login lifetime: short access tokens renewed by a rotating refresh token.
#ACCESS_TOKEN_MINUTES=15
#REFRESH_TOKEN_HOURS=168
# Failed logins / password changes / bootstrap attempts allowed per IP within the window.
#AUTH_MAX_FAILURES=5
#AUTH_FAILURE_WINDOW_SECONDS=300
# Background maintenance (expiry, warnings, waitlist, retention); interval in seconds.
#SCHEDULER_INTERVAL_SECONDS=30
